{
    "tasks": [
        {
            "type": "shell",
            "label": "XCPlite: sync clock on Linux",
            "command": "ssh rainer@192.168.0.206 \"sudo date -s @$(date +%s)\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "detail": "Sync system clock on Linux with local time"
        },
        {
            "type": "shell",
            "label": "XCPlite: sync to Linux",
            "command": "rsync",
            "args": [
                "-avz",
                "--delete",
                "--exclude=build/",
                "--exclude=build_freertos/",
                "--exclude=build_no_a2l_demo/",
                "--exclude=build_ptptool/",
                "--exclude=tools/xcpclient/target/",
                "--exclude=.git/",
                "--exclude=.examples/esp32_freertos_demo/.pio/",
                "--exclude=.venv/",
                "--exclude=\"*.o\"",
                "--exclude=\"*.a\"",
                "--exclude=\"*.mf4\"",
                "./",
                "rainer@192.168.0.206:~/XCPlite-RainerZ/"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "XCPlite: sync clock on Linux",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "detail": "rsync to Linux rainer@192.168.0.206:~/XCPlite-RainerZ/"
        },
        {
            "type": "shell",
            "label": "XCPlite: Remote build lib and examples on Linux",
            "command": "ssh",
            "args": [
                "rainer@192.168.0.206",
                "cd ~/XCPlite-RainerZ && cmake --build build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "XCPlite: Remote configure CMake on Linux",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build all targets on Linux"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang Aktive Datei kompilieren",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Vom Debugger generierte Aufgabe."
        },
        {
            "type": "shell",
            "label": "cmake configure",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-S",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure CMake build system"
        },
        {
            "type": "shell",
            "label": "XCPlite: Remote configure CMake on Linux",
            "command": "ssh",
            "args": [
                "rainer@192.168.0.206",
                "cd ~/XCPlite-RainerZ && cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "dependsOn": "XCPlite: sync to Linux",
            "detail": "Configure CMake build system on Linux"
        },
        {
            "type": "cargo",
            "label": "cargo build xcpclient",
            "command": "build",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/tools/xcpclient"
            },
            "group": "build",
            "detail": "Build xcpclient (debug)"
        },
        {
            "type": "shell",
            "label": "XCPlite: configure freertos_demo",
            "command": "cmake",
            "args": [
                "-B",
                "build-freertos",
                "-S",
                ".",
                "-DXCPLITE_BUILD_FREERTOS_DEMO=ON",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configure CMake for freertos_demo with Debug symbols"
        },
        {
            "type": "shell",
            "label": "XCPlite: build freertos_demo",
            "command": "cmake",
            "args": [
                "--build",
                "build-freertos",
                "--target",
                "freertos_demo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "dependsOn": "XCPlite: configure freertos_demo",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build freertos_demo (Debug)"
        },
        {
            "type": "shell",
            "label": "XCPlite: Fetch freertos_demo ELF from Linux",
            "command": "rsync",
            "args": [
                "-avz",
                "--exclude=CMakeFiles/",
                "--exclude=_deps/",
                "--exclude=\"*.cmake\"",
                "--exclude=\"Makefile*\"",
                "--exclude=\"*.txt\"",
                "--exclude=\"*.json\"",
                "--exclude=\"*.a\"",
                "--exclude=\"*.o\"",
                "rainer@192.168.0.206:~/XCPlite-RainerZ/build-freertos/",
                "./"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "detail": "Fetch compiled ELF binaries from Linux into build/pi/",
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}